---
interface Props {
  title: string;
  description: string;
  href?: string;
  imageSrc?: string;
}

const { title, description, href = '#', imageSrc } = Astro.props;
---
<article class="border border-black overflow-hidden bg-white">
  {imageSrc && (
    <div class="aspect-video bg-black/5">
      <!-- PLACEHOLDER: Replace with real image -->
      <img src={imageSrc} alt="" class="w-full h-full object-cover" />
    </div>
  )}
  <div class="p-6">
    <h3 class="font-heading text-xl uppercase mb-2 text-black">
      {title}
    </h3>
    <p class="font-body text-black/80 mb-4">
      {description}
    </p>
    <a
      href={href}
      class="inline-block font-body text-sm font-medium uppercase text-accent hover:underline"
    >
      Learn more →
    </a>
  </div>
</article>
