---
interface Props {
  current: string;
}

const { current } = Astro.props;
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
];

function isActive(href: string) {
  if (href === '/') return current === '/';
  return current.startsWith(href);
}
---
<header class="border-b border-black">
  <div class="max-w-content mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="font-heading font-bold text-xl uppercase tracking-tight text-black hover:text-accent transition-colors">
      Pete McPherson
    </a>
    <nav class="flex items-center gap-8" aria-label="Main navigation">
      {navItems.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'font-body text-sm font-medium uppercase tracking-wide transition-colors',
            isActive(href) ? 'text-accent' : 'text-black hover:text-accent'
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
