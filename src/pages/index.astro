---
import Layout from '../layouts/Layout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Layout title="Pete McPherson | Home" description="Pete McPherson — [PLACEHOLDER: Short meta description for the home page.]">
  <section class="max-w-content mx-auto px-6 pt-16 pb-12 md:pt-24 md:pb-16">
    <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl uppercase max-w-2xl mb-4">
      [PLACEHOLDER: Bold headline introducing Pete — e.g. "Hi, I'm Pete McPherson."]
    </h1>
    <p class="font-body text-xl text-black/80 max-w-xl">
      [PLACEHOLDER: Short tagline or subtitle — e.g. "I help people build better habits and ship things that matter."]
    </p>
  </section>
  <NewsletterForm />

  <section class="max-w-content mx-auto px-6 pb-20 md:pb-28 border-t border-black/10 pt-16">
    <p class="font-body text-lg text-black/90 max-w-2xl mb-8 leading-relaxed">
      [PLACEHOLDER: Brief intro paragraph about Pete — background, what he does, and why visitors should care. Replace with real copy.]
    </p>
    <a
      href="/projects"
      class="inline-block px-6 py-3 font-heading font-bold uppercase bg-accent text-white border-2 border-accent hover:bg-white hover:text-accent transition-colors"
    >
      View projects
    </a>
  </section>
</Layout>
